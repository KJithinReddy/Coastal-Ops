# Copy to .env for local MCP server runs. Do not commit filled-in values.

LAKEBASE_URL=postgresql://ROLE:PASSWORD@HOST.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

NWS_USER_AGENT=(dataexpert-capstone-coastal-ops-mcp, student@example.com)
MARINE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PORT=8000
