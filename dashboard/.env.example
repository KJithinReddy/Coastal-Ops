# Copy to .env for local dashboard runs. Do not commit filled-in values.

LAKEBASE_URL=postgresql://ROLE:PASSWORD@HOST.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require
LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=8000
NWS_USER_AGENT=(dataexpert-capstone-coastal-ops-dashboard, student@example.com)
